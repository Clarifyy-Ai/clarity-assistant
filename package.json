{
  "name": "clarify-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env BUILD_TARGET=electron concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",

    "build": "vite build",
    "build:dev": "vite build --mode development",

    "dist:mac": "cross-env BUILD_TARGET=electron vite build && electron-builder --mac",
    "dist:win": "cross-env BUILD_TARGET=electron vite build && electron-builder --win",
    "dist:linux": "cross-env BUILD_TARGET=electron vite build && electron-builder --linux",

    "preview": "vite preview",

    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",

    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",

    "format": "prettier --write .",

    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "validate-env": "node scripts/validate-env.js",

    "supabase:gen": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.ts"
  },

  "build": {
    "appId": "com.clarify.ai",
    "productName": "ClarifyAI",
    "asar": true,

    "files": [
      "dist/**/*",
      "electron/**/*"
    ],

    "directories": {
      "output": "release"
    },

    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "icon": "public/icon.icns"
    },

    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "public/icon.ico"
    },

    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "public/icon.png"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },

    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },

  "dependencies": {
    "@deepgram/sdk": "^3.3.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",

    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.2",

    "@sentry/react": "^8.28.0",
    "@sentry/vite-plugin": "^2.22.4",

    "@supabase/supabase-js": "^2.99.2",

    "@tailwindcss/typography": "^0.5.19",

    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-table": "^8.20.5",

    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",

    "date-fns": "^3.6.0",

    "embla-carousel-react": "^8.5.1",

    "framer-motion": "^11.9.0",

    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "xlsx": "^0.18.5",

    "immer": "^11.1.4",

    "input-otp": "^1.4.2",

    "katex": "^0.16.40",
    "lucide-react": "^0.462.0",

    "posthog-js": "^1.161.0",

    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.53.0",
    "react-hotkeys-hook": "^4.5.1",
    "react-katex": "^3.1.0",
    "react-resizable-panels": "^4.7.3",
    "react-router-dom": "^6.26.2",

    "recharts": "^2.12.7",

    "sonner": "^1.5.0",

    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",

    "vaul": "^0.9.9",

    "zod": "^3.23.8",

    "zustand": "^5.0.0",

    "dompurify": "^3.1.6"
  },

  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",

    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/dompurify": "^3.0.5",

    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",

    "@vitejs/plugin-react-swc": "^3.7.1",

    "@vitest/coverage-v8": "^2.1.1",
    "@vitest/ui": "^2.1.1",

    "autoprefixer": "^10.4.20",

    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",

    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",

    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",

    "jsdom": "^25.0.1",

    "msw": "^2.3.2",

    "postcss": "^8.4.47",
    "prettier": "^3.3.3",

    "supabase": "^1.191.3",

    "tailwindcss": "^3.4.13",

    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.0"
  }
}
