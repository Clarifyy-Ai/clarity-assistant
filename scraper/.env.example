# ── Supabase (required) ─────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role key, server-side only
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
# Swagger is disabled by default; use development only for local API exploration.
APP_ENV=production

# ── Storage buckets (must already exist in Supabase) ─
STORAGE_BUCKET_PAPERS=exam-papers
STORAGE_BUCKET_IMAGES=question-images

# ── CORS (frontend origins) ─────────────────────────
# Comma-separated. Include your production web app origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://clarify-aii.lovable.app
# Optional regex (e.g. allow all *.lovable.app previews)
CORS_ORIGIN_REGEX=^https://.*\.lovable\.app$

# ── Politeness ──────────────────────────────────────
SCRAPE_DELAY_SECONDS=2.0
SCRAPE_MAX_CONCURRENCY=10
SCRAPE_PER_DOMAIN_CONCURRENCY=2
SCRAPE_USER_AGENT=clarity-exam-scraper/1.0 (+admin)

# ── Daily scrape (while this container is running) ──
SCRAPE_DAILY_ENABLED=true
SCRAPE_DAILY_HOUR_UTC=2

# ── Service ─────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO

# ── Internal document-intelligence authentication ─────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCUMENT_INTELLIGENCE_AUTH_SECRET=replace-with-a-32-character-random-secret
# Keep the old secret here only during a controlled rotation window.
DOCUMENT_INTELLIGENCE_AUTH_PREVIOUS_SECRET=
DOCUMENT_INTELLIGENCE_AUTH_MAX_SKEW_SECONDS=300
DOCUMENT_INTELLIGENCE_AUTH_REPLAY_TTL_SECONDS=600
DOCUMENT_INTELLIGENCE_MAX_REQUEST_BYTES=1048576

# ── Document intelligence embedded worker ─────────────────────────────────
# When true (default), the web process polls PostgreSQL document jobs via
# claim_document_processing_job. Set false to run a dedicated Background Worker.
DOCUMENT_WORKER_EMBEDDED=true
DOCUMENT_WORKER_POLL_SECONDS=5
DOCUMENT_WORKER_LEASE_SECONDS=180

# ── Paper factory (gov exam AI generation) ────────────────────────────────
# Required for AI-assisted gov mock papers. Worker starts automatically in the
# web process when an AI key is set (PAPER_FACTORY_EMBEDDED_WORKER=true).
PAPER_FACTORY_EMBEDDED_WORKER=true
GEMINI_API_KEY=
OPENAI_API_KEY=
# Auth user UUID used as questions.uploaded_by / created_by (must exist in auth.users)
SYSTEM_USER_ID=
PAPER_FACTORY_GEMINI_MODEL=gemini-2.5-flash
PAPER_FACTORY_OPENAI_MODEL=gpt-4o-mini
PAPER_FACTORY_BATCH_SIZE=8
PAPER_FACTORY_CONCURRENCY=4
PAPER_FACTORY_MAX_REPAIR_ROUNDS=4
PAPER_FACTORY_TIMEOUT_SECONDS=180
PAPER_FACTORY_TEMPERATURE=0.85
PAPER_FACTORY_LEASE_SECONDS=600
PAPER_FACTORY_POLL_SECONDS=5
PAPER_FACTORY_MAX_JOB_ATTEMPTS=3
