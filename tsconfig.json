{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/pages/Analytics.tsx",
    "src/pages/Dashboard.tsx",
    "src/pages/DocumentVault.tsx",
    "src/pages/InterviewScheduler.tsx",
    "src/pages/LiveCopilot.tsx",
    "src/pages/MockSession.tsx",
    "src/pages/PrepLab.tsx",
    "src/pages/Scorecard.tsx",
    "src/pages/app/Analytics.tsx",
    "src/pages/app/Dashboard.tsx",
    "src/pages/app/InterviewDay.tsx",
    "src/pages/app/interviews/**",
    "src/pages/app/mock/**",
    "src/pages/app/practice/**",
    "src/pages/app/prep/PrepLab.tsx",
    "src/pages/app/sessions/**",
    "src/pages/app/debrief/**",
    "src/pages/app/answer-bank/**",
    "src/pages/app/company-research/**",
    "src/pages/app/documents/**",
    "src/pages/app/live/**",
    "src/pages/app/settings/**",
    "src/pages/app/admin/**"
  ],
  "include": [
    "src",
    "vite.config.ts"
  ]
}