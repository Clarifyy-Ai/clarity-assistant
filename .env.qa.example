# AI Hub edge secrets (never VITE_*). Default mock mode for QA.
# AI_PROVIDER_MODE=mock
# AI_FREE_TIER_DAILY_TOKENS=250000
# AI_DAILY_BUDGET_USD=2

# Edge secrets checklist (commented docs only — no real values)
# DEEPGRAM_PROJECT_ID=your_deepgram_project_id_here
# OCR_API_KEY=your_ocr_api_key_here
# ALLOWED_ORIGINS=https://clarify.ai.sltfinanceindia.com,http://localhost:5173
# PUBLIC_URL=https://clarify.ai.sltfinanceindia.com
# SITE_URL=https://clarify.ai.sltfinanceindia.com
# APP_ENV=staging
# ENVIRONMENT=staging
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Interview reminder cron (optional): INTERVIEW_REMINDER_CRON_SECRET or CRON_SECRET
# Prefer RESEND_FROM_EMAIL; FROM_EMAIL is an accepted alias for the same From address.
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# FROM_EMAIL=Career Pilot <noreply@yourdomain.com>
