{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": ["vitest/globals"],
    "useDefineForClassFields": true,
    "suppressImplicitAnyIndexErrors": true
  },
  "include": ["src"],
  "exclude": [
    "src/pages/Analytics.tsx",
    "src/pages/Dashboard.tsx",
    "src/pages/DocumentVault.tsx",
    "src/pages/InterviewScheduler.tsx",
    "src/pages/LiveCopilot.tsx",
    "src/pages/MockSession.tsx",
    "src/pages/PrepLab.tsx",
    "src/pages/Scorecard.tsx",
    "src/pages/app/Analytics.tsx",
    "src/pages/app/Dashboard.tsx",
    "src/pages/app/InterviewDay.tsx",
    "src/pages/app/interviews/InterviewDetail.tsx",
    "src/pages/app/interviews/Interviews.tsx",
    "src/pages/app/interviews/NewInterview.tsx",
    "src/pages/app/mock/MockInterview.tsx",
    "src/pages/app/mock/MockSession.tsx",
    "src/pages/app/mock/MockWarmup.tsx",
    "src/pages/app/practice/PracticeRooms.tsx",
    "src/pages/app/prep/PrepLab.tsx",
    "src/pages/app/sessions/SessionDetail.tsx",
    "src/pages/app/sessions/SessionHistory.tsx",
    "src/pages/app/debrief/Debrief.tsx",
    "src/pages/app/debrief/DebriefDetail.tsx",
    "src/pages/app/answer-bank/AnswerBank.tsx",
    "src/pages/app/company-research/CompanyProfile.tsx",
    "src/pages/app/company-research/CompanyResearch.tsx",
    "src/pages/app/documents/Documents.tsx",
    "src/pages/app/live/LiveOverlay.tsx",
    "src/pages/app/live/LiveRehearsal.tsx",
    "src/pages/app/settings/SettingsSubscription.tsx",
    "src/pages/app/settings/SettingsCredits.tsx",
    "src/pages/app/settings/SettingsData.tsx",
    "src/pages/app/settings/SettingsDanger.tsx",
    "src/pages/app/settings/SettingsIntegrations.tsx",
    "src/pages/app/settings/SettingsNotifications.tsx",
    "src/pages/app/settings/SettingsPrivacy.tsx",
    "src/pages/app/settings/SettingsProfile.tsx",
    "src/pages/app/settings/SettingsAudio.tsx",
    "src/pages/app/settings/SettingsAppearance.tsx",
    "src/pages/app/settings/Settings.tsx",
    "src/pages/app/admin/AdminAnalytics.tsx",
    "src/pages/app/admin/AdminDashboard.tsx",
    "src/pages/app/admin/AdminFlags.tsx",
    "src/pages/app/admin/AdminLayout.tsx",
    "src/pages/app/admin/AdminUsers.tsx"
  ]
}
