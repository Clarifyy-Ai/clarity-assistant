{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",

    /* Keep your current runtime posture to avoid breaking builds right now */
    "strict": false,
    "skipLibCheck": true,

    /* App-specific globals/types (Vite runtime envs, import.meta) */
    "types": ["vite/client"],

    /* Preserve your alias */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
