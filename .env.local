# ─────────────────────────────────────────────────────────────────
# ConfideQ — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (Edge Functions / CI) — NOT exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# ── AI Providers (server-side Edge Functions only) ────────────────
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Deepgram (Speech-to-Text) ─────────────────────────────────────
# Client-side temporary token is issued by Edge Function using this key
DEEPGRAM_API_KEY=your-deepgram-api-key
VITE_DEEPGRAM_STT_URL=wss://api.deepgram.com/v1/listen

# ── PostHog (Analytics) ───────────────────────────────────────────
VITE_POSTHOG_KEY=phc_your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Sentry (Error Monitoring) ─────────────────────────────────────
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=confideq
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Stripe (Billing) ──────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_TEAM_MONTHLY=price_team_monthly_id
STRIPE_PRICE_CREDITS_10=price_credits_10_id

# ── Google OAuth (Calendar Sync) ──────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── App Config ────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:8080
VITE_APP_NAME=ConfideQ
VITE_APP_ENV=development

# Feature flags (set to "true" / "false")
VITE_FF_TEAM_ROOMS=true
VITE_FF_COLLABORATIVE_ROOMS=true
VITE_FF_LEADERBOARD=true
VITE_FF_REFERRALS=true
VITE_FF_BYOK=true
VITE_FF_ADMIN_PANEL=false

# ── Rate Limits ───────────────────────────────────────────────────
VITE_MAX_FREE_CREDITS=5
VITE_MAX_RESUME_SIZE_MB=5
VITE_MAX_RESUME_VERSIONS=5
