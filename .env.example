# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env.local and fill in your own values.
#
# SECURITY RULES:
# - NEVER commit .env or .env.local to version control.
# - ONLY variables prefixed with VITE_ are exposed to the browser.
# - Server secrets must be stored in Supabase Dashboard → Edge Functions → Secrets.
# - Do NOT place production secrets directly in this file.
#
# Setup:
# 1. cp .env.example .env.local
# 2. Fill in your real local/dev values
# 3. Run: npm run validate-env
# 4. Run: npm run dev
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Supabase Frontend Config
# These are public client-side values, but must still come from env variables.
# Get these from:
# Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — App Config
# VITE_APP_ENV allowed values:
# development | staging | production
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_NAME=Career Pilot
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development
VITE_API_URL=/api

# Comma-separated OAuth providers shown on login/signup.
# Unset / empty / "none" → hide all OAuth CTAs (fail closed until Supabase provider is enabled).
# Only set providers that are enabled in Supabase Auth → Providers.
# To enable Google sign-in: VITE_OAUTH_PROVIDERS=google
# Examples: none | google | google,github
VITE_OAUTH_PROVIDERS=none

# Dev/QA override for India-only features (Gov Exam Mock Tests). true | false | unset
# VITE_FORCE_INDIA_REGION=true

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Desktop app installer download URLs
# Set at least one for in-app "Download" buttons to serve a real .exe / .dmg.
# After building: npm run dist:win  →  release/Career Pilot Setup *.exe
# Upload that file to GitHub Releases, Supabase Storage, or your CDN, then paste URL here.
# ─────────────────────────────────────────────────────────────────────────────

# All platforms (fallback)
# VITE_DESKTOP_DOWNLOAD_URL=https://github.com/Clarifyy-Ai/career-pilot-releases/releases/latest/download/Career-Pilot-Setup.exe

# Per-platform (recommended). Production uses a same-origin proxy:
# /download/Career-Pilot-Setup.exe (GitHub is fetched server-side).
# VITE_DESKTOP_DOWNLOAD_URL_WIN=/download/Career-Pilot-Setup.exe
# VITE_DESKTOP_DOWNLOAD_URL_MAC=
# VITE_DESKTOP_DOWNLOAD_URL_LINUX=

# Auto-resolve latest .exe/.dmg from GitHub Releases when env URLs are empty
# Optional: only set when the repo is public and has published Releases
# VITE_GITHUB_RELEASE_REPO=Clarifyy-Ai/clarity-assistant


# ─────────────────────────────────────────────────────────────────────────────
# ELECTRON DESKTOP — APIs / env the operator must add
# Source of truth for packaging the desktop app (npm run dist:win / Electron Release).
# Same VITE_* values as the production web app. Do NOT put AI/payment secrets in
# Electron or GitHub Actions Electron secrets — they stay in Edge Function secrets.
# Verify: npm run electron:check-config
# ─────────────────────────────────────────────────────────────────────────────
#
# REQUIRED for Electron build (same as web — baked into the renderer at build time):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_SUPABASE_PROJECT_ID
#   VITE_APP_URL          ← production website (https://…), NOT localhost when packaging
#   VITE_APP_ENV          ← production for release builds
#   VITE_APP_NAME
#
# OPTIONAL:
#   VITE_OAUTH_PROVIDERS=google
#   VITE_DESKTOP_DOWNLOAD_URL_WIN   (web app “Download” buttons)
#   VITE_GITHUB_RELEASE_REPO        (web app “Download” buttons)
#
# EDGE SECRETS (not VITE_ — set via npm run qa:sync-secrets or Dashboard → Edge Secrets):
#   ALLOW_ELECTRON_NULL_ORIGIN=true
#   ALLOWED_ORIGINS                 (production website origin)
#   SITE_URL
#   PUBLIC_URL
#
# GitHub Actions → repo secrets for workflow “Electron Release”:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY,
#   VITE_APP_URL, VITE_SUPABASE_PROJECT_ID, VITE_OAUTH_PROVIDERS
#
# Do NOT add OPENAI / GEMINI / DEEPGRAM / STRIPE secret keys to Electron, .env used
# for desktop packaging, or Electron Release GitHub secrets. Those stay in
# Supabase Dashboard → Edge Functions → Secrets only.
#
# Auth: add the production website origin to Supabase Auth → URL Configuration
# (Site URL + Redirect URLs). Electron uses that origin for “Open in browser”.


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — FastAPI Gov-Exam Scraper (admin-only)
# Self-hosted scraper service (see scraper/README.md). Leave blank to disable
# the admin scraper UI. Admin role is enforced server-side via the user JWT.
# ─────────────────────────────────────────────────────────────────────────────
# Production (Render): https://clarity-assistant-az05.onrender.com
# Leave blank locally to disable the admin scraper UI.
VITE_SCRAPER_URL=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Stripe Frontend Config
# Public browser-safe key only.
# Secret keys must NOT be prefixed with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Stripe price IDs used by the frontend pricing/billing UI
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
VITE_STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly
VITE_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
VITE_STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
VITE_STRIPE_PRICE_ELITE_MONTHLY=price_elite_monthly
VITE_STRIPE_PRICE_ELITE_YEARLY=price_elite_yearly
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly
VITE_STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly

# Credit pack price IDs (50 / 150 / 500 packs)
VITE_STRIPE_PRICE_CREDITS_50=price_credits_50
VITE_STRIPE_PRICE_CREDITS_150=price_credits_150
VITE_STRIPE_PRICE_CREDITS_500=price_credits_500


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Analytics
# Public status page (Help Center). Leave empty to fall back to support mailto.
# VITE_STATUS_PAGE_URL=https://status.example.com
# These are public browser-side analytics values.
# ─────────────────────────────────────────────────────────────────────────────

VITE_POSTHOG_KEY=phc_your_posthog_project_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Google Ads conversion tracking (optional). Create an Ads account, then:
# Tools → Conversions → tag setup → Conversion ID (AW-…) and event labels.
# Scripts load only after the cookie banner is Accepted, and never in Electron.
# VITE_GOOGLE_ADS_ID=AW-0000000000
# VITE_GOOGLE_ADS_SIGNUP_LABEL=
# VITE_GOOGLE_ADS_PURCHASE_LABEL=
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# Publisher id for public/ads.txt if you sell inventory (AdSense), not for buying ads:
# VITE_GOOGLE_ADS_PUBLISHER_ID=pub-0000000000000000


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Sentry Frontend Error Tracking
# Browser DSN only.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SENTRY_DSN=https://your-public-sentry-dsn@sentry.io/project-id


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Feature Flags
# Keep defaults safe for production.
# ─────────────────────────────────────────────────────────────────────────────

# Build-time feature toggles (see docs/qa/FEATURE_FLAGS_MATRIX.md)
# false = hide beta_models even when plan allows; unset/true = plan gate only
VITE_ENABLE_BETA_MODELS=false
VITE_ENABLE_DEBUG_PANEL=false


# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — DO NOT USE IN FRONTEND
#
# These must be configured in:
# Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# Do NOT prefix these with VITE_.
# Do NOT commit real values.
# Do NOT expose these in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# AI provider secrets
OPENAI_API_KEY=sk_your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here

# AI Hub (edge-only) — mock is fail-closed for spend. Set live for Admin Hub Lab.
AI_PROVIDER_MODE=mock
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=20
AI_MAX_REQUEST_COST_USD=0.10
AI_MAX_OUTPUT_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=100
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_FREE_TIER_ENABLED=true
# Sized like a modest Flash free-tier daily cap; configurable — not a vendor lock-in number
AI_FREE_TIER_DAILY_TOKENS=250000
AI_ROUTING_ENABLED=true
AI_ACCELERATION_DEFAULT_TIER=standard

# Deepgram server-side key (+ project ID for scoped tokens)
DEEPGRAM_API_KEY=your_deepgram_key_here
# DEEPGRAM_PROJECT_ID=your_deepgram_project_id_here

# OCR (edge document parsing — optional until OCR path is enabled)
# OCR_API_KEY=your_ocr_api_key_here

# Hybrid Python processing service (Edge → FastAPI HMAC /internal/operations)
# Set BOTH in Supabase Dashboard → Edge Functions → Secrets (NEVER VITE_):
#   PYTHON_SERVICE_URL=https://clarity-assistant-az05.onrender.com
#   DOCUMENT_INTELLIGENCE_AUTH_SECRET=<same 32+ char secret as Render>
# Optional: PYTHON_REQUEST_TIMEOUT_MS=25000
# Optional chaos flags: HYBRID_FORCE_PYTHON_UNAVAILABLE=1  HYBRID_FORCE_AI_UNAVAILABLE=1
PYTHON_SERVICE_URL=
# or SCRAPER_URL=
DOCUMENT_INTELLIGENCE_AUTH_SECRET=
#
# Render scraper CORS (Render Dashboard → clarity-scraper → Environment; overrides render.yaml):
# CORS_ORIGINS=https://trycareerpilot.com,https://www.trycareerpilot.com,https://clarify.ai.sltfinanceindia.com
PAPER_FACTORY_WORKER=1

# Stripe server-side secrets
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Razorpay (India payments — edge functions only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email provider secrets (Edge only — never VITE_*).
# Hostinger Mail API is preferred for product mail (send-email + admin mailbox).
# Set the real token in Supabase Dashboard → Edge Functions → Secrets, not in git.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_ADDRESS=hello@trycareerpilot.com
FROM_EMAIL=Career Pilot <hello@trycareerpilot.com>
# Fallback if Hostinger is unset. Prefer RESEND_FROM_EMAIL as an alias of FROM_EMAIL.
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=Career Pilot <hello@trycareerpilot.com>
# Universal public mailbox (sales, support, legal). contact-sales uses this if set.
SALES_EMAIL=hello@trycareerpilot.com
#
# Product mail uses Hostinger REST (api.mail.hostinger.com), not SMTP.
# Password reset / signup confirmation mail is sent by Supabase Auth, not send-email.
# Optional Auth SMTP (needs the mailbox password, not the Mail API token):
#   host: smtp.hostinger.com  port: 465  user: hello@trycareerpilot.com
# HOSTINGER_SMTP_PASSWORD=
# Redirect URLs must include {VITE_APP_URL}/reset-password and {VITE_APP_URL}/auth/callback.
# QA_RESET_INBOX_EMAIL must be a deliverable mailbox (not .test) for reset-delivery proof.

# Ingest / cron (edge-only)
INGEST_API_KEY=replace-with-rotated-ingest-key
# CRON_SECRET=replace-with-rotated-cron-secret

# Optional OAuth (configure in Supabase Auth; secrets are not VITE_*)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Google Calendar (Edge Functions: sync-calendar / disconnect-calendar).
# Create an OAuth Web client in Google Cloud Console with Calendar API enabled.
# Set these in Supabase Dashboard → Edge Functions → Secrets (NOT VITE_*).
# Authorized redirect URI (Calendar connect, NOT login):
#   https://trycareerpilot.com/app/settings/calendar-callback
# Development only:
#   http://localhost:5173/app/settings/calendar-callback
# Google Sign-In uses the Supabase Auth Google provider (identity scopes only).
# Do not put GOOGLE_CLIENT_SECRET in any VITE_ variable.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Interview reminder cron (optional; send-interview-reminders edge function).
# Prefer CRON_SECRET or INTERNAL_WORKER_SECRET; mirror into Vault as
# interview_reminder_cron_secret when using pg_cron (see migration comment).
# INTERVIEW_REMINDER_CRON_SECRET=


# Edge runtime URLs / CORS / environment labels (sync via npm run qa:sync-secrets)
# ALLOWED_ORIGINS=https://trycareerpilot.com,https://www.trycareerpilot.com,https://clarify.ai.sltfinanceindia.com
# Production defaults: localhost and Lovable preview CORS are off unless explicitly true.
# ALLOW_LOCALHOST_ORIGINS=false
# ALLOW_PREVIEW_ORIGINS=false
# ALLOW_ELECTRON_NULL_ORIGIN=true
# PUBLIC_URL=https://trycareerpilot.com
# SITE_URL=https://trycareerpilot.com
# APP_ENV=production
# ENVIRONMENT=production

# Supabase backend secret
# WARNING: Service role key bypasses RLS.
# Use only inside trusted edge functions.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Sentry Build Upload Config
# Used only during production build for sourcemap upload.
# Do not expose these to browser runtime.
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Local Development Only
# Uncomment only if needed.
# ─────────────────────────────────────────────────────────────────────────────

# VITE_HOST=127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1
