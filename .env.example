# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Providers (server-side / edge functions only) ─────────────────────────
# These are set in Supabase Dashboard → Edge Functions → Secrets
# Do NOT prefix with VITE_ — they must never reach the browser
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── BYOK — user-supplied keys (optional, stored encrypted) ───────────────────
# VITE_BYOK_ENCRYPTION_SALT=your-32-char-salt-here

# ── Stripe ────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Clarity
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development          # development | staging | production

# ── Feature flags (override defaults locally) ────────────────────────────────
VITE_ENABLE_BETA_MODELS=false
VITE_ENABLE_DEBUG_PANEL=true

# ── Analytics (optional) ─────────────────────────────────────────────────────
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://app.posthog.com

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=https://...@sentry.io/...
