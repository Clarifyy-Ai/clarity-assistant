# Production frontend env template — copy to .env.production locally.
# NEVER commit real values. Rotate any key that was previously committed.

VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_SUPABASE_ANON_KEY=your_anon_key

VITE_APP_NAME=Clarify AI
VITE_APP_URL=https://your-production-domain.example
VITE_APP_ENV=production

# Desktop installer (after npm run publish:desktop-installer)
VITE_DESKTOP_DOWNLOAD_URL_WIN=
VITE_GITHUB_RELEASE_REPO=your-org/your-repo

# Optional Stripe (browser price IDs)
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=
VITE_STRIPE_PRICE_ENTERPRISE_YEARLY=
VITE_STRIPE_PRICE_CREDITS_50=
VITE_STRIPE_PRICE_CREDITS_150=
VITE_STRIPE_PRICE_CREDITS_500=
