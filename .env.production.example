# Production frontend env template — copy to .env.production locally.
# NEVER commit real values. Rotate any key that was previously committed.

VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_SUPABASE_ANON_KEY=your_anon_key

VITE_APP_NAME=Career Pilot
VITE_APP_URL=https://your-production-domain.example
VITE_APP_ENV=production

# ── ELECTRON DESKTOP (comments = operator checklist; keep placeholders) ──
# REQUIRED for Electron packaging — same public keys as this web production env.
# VITE_APP_URL must be the production website, not localhost.
# Optional: VITE_OAUTH_PROVIDERS=google
# Do NOT add OPENAI / GEMINI / DEEPGRAM / STRIPE secret keys here. Edge secrets only.
# Edge CORS (npm run qa:sync-secrets / Dashboard — not VITE_):
#   ALLOW_ELECTRON_NULL_ORIGIN=true
#   ALLOWED_ORIGINS=https://your-production-domain.example
#   SITE_URL=https://your-production-domain.example
#   PUBLIC_URL=https://your-production-domain.example
# GitHub Actions secrets for “Electron Release”:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY,
#   VITE_APP_URL, VITE_SUPABASE_PROJECT_ID, VITE_OAUTH_PROVIDERS
# Check: npm run electron:check-config

# Desktop installer (after npm run publish:desktop-installer)
VITE_DESKTOP_DOWNLOAD_URL_WIN=
VITE_GITHUB_RELEASE_REPO=your-org/your-repo

# Optional Stripe (browser price IDs)
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=
VITE_STRIPE_PRICE_ENTERPRISE_YEARLY=
VITE_STRIPE_PRICE_CREDITS_50=
VITE_STRIPE_PRICE_CREDITS_150=
VITE_STRIPE_PRICE_CREDITS_500=

# Google Calendar secrets belong in Supabase Edge secrets, never VITE_*.
# Production Calendar redirect:
#   https://YOUR_PRODUCTION_HTTPS_DOMAIN/app/settings/calendar-callback
# Do not register localhost as a production redirect URI.

